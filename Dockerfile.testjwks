FROM golang:1.27.0-alpine@sha256:4c9fe60190a2a3350ddc51de80d0224b8a6698d12bdfc999fee45ea9d6c46dbc AS builder

WORKDIR /build

COPY go.mod go.sum ./
RUN go mod download

COPY cmd cmd/
COPY events events/
COPY internal internal/

RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -o testjwks ./cmd/testjwks

FROM registry.access.redhat.com/ubi9/ubi-minimal@sha256:8eb2830d0936237fc13a1f2f7e45aecf90d69043380ad167fad0343632937f41

RUN microdnf install -y curl-minimal && microdnf clean all

WORKDIR /app
COPY --from=builder /build/testjwks /app/testjwks

RUN mkdir -p /tokens && chown 1001:1001 /tokens

ENV TESTJWKS_LISTEN_ADDR=":8888"
ENV TESTJWKS_OUTPUT_DIR="/tokens"
ENV ISSUER_URL="http://testjwks:8888"

EXPOSE 8888

HEALTHCHECK --interval=5s --timeout=3s --retries=5 \
  CMD curl -sf http://localhost:8888/healthz || exit 1

USER 1001:1001

ENTRYPOINT ["/app/testjwks"]
