# Multi-stage build for locker service
# Stage 1: Build
FROM golang:1.26.5-alpine@sha256:0178a641fbb4858c5f1b48e34bdaabe0350a330a1b1149aabd498d0699ff5fb2 AS builder

WORKDIR /build

COPY go.mod go.sum ./
RUN go mod download

COPY cmd cmd/
COPY events events/
COPY internal internal/

# Build the binary
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -o locker ./cmd/locker

# Stage 2: Runtime
FROM registry.access.redhat.com/ubi9/ubi-minimal:latest

RUN microdnf install -y curl-minimal && microdnf clean all

WORKDIR /app

COPY --from=builder /build/locker /app/locker

RUN mkdir -p /data/ledgers && chown 1001:1001 /data/ledgers

ENV LOCKER_DATA_PATH="/data/ledgers" \
    LOCKER_LISTEN_ADDR=":8081"

USER 1001:1001

ENTRYPOINT ["/app/locker"]
