# Multi-stage build for locker service
# Stage 1: Build
FROM golang:1.27.4-alpine@sha256:70bd7ddea8b6cbe5d6943cde279d6b67feb10cc924fb9100d1d8757c1575b280 AS builder

WORKDIR /build

COPY go.mod go.sum ./
RUN go mod download

COPY cmd cmd/
COPY events events/
COPY internal internal/

# Build the binary
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -o locker ./cmd/locker

# Stage 2: Runtime
FROM registry.access.redhat.com/ubi9/ubi-minimal@sha256:08d4c70f1baf6537a0728656cf7942d561e74a35916509d205b6519861266352

RUN microdnf install -y curl-minimal && microdnf clean all

WORKDIR /app

COPY --from=builder /build/locker /app/locker

RUN mkdir -p /data/ledgers && chown 1001:1001 /data/ledgers

ENV LOCKER_DATA_PATH="/data/ledgers" \
    LOCKER_LISTEN_ADDR=":8081"

USER 1001:1001

ENTRYPOINT ["/app/locker"]
