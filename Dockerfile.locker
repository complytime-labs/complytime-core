# Multi-stage build for locker service
# Stage 1: Build
FROM golang:1.27.1-alpine@sha256:cf6fca6641884b8433441b2b0652976f975e1d0fdd26d177eaaf8596087f3125 AS builder

WORKDIR /build

COPY go.mod go.sum ./
RUN go mod download

COPY cmd cmd/
COPY events events/
COPY internal internal/

# Build the binary
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -o locker ./cmd/locker

# Stage 2: Runtime
FROM registry.access.redhat.com/ubi9/ubi-minimal@sha256:d235f607e1d6d833f031db107dc42206e4dd4d5aa9142c43d3771fb7f9bea76a

RUN microdnf install -y curl-minimal && microdnf clean all

WORKDIR /app

COPY --from=builder /build/locker /app/locker

RUN mkdir -p /data/ledgers && chown 1001:1001 /data/ledgers

ENV LOCKER_DATA_PATH="/data/ledgers" \
    LOCKER_LISTEN_ADDR=":8081"

USER 1001:1001

ENTRYPOINT ["/app/locker"]
