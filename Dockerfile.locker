# Multi-stage build for locker service
# Stage 1: Build
FROM golang:1.26.6-alpine@sha256:3889b425f035be855a72fb4755265311293b6d414521f0a519d819df32222d83 AS builder

WORKDIR /build

COPY go.mod go.sum ./
RUN go mod download

COPY cmd cmd/
COPY events events/
COPY internal internal/

# Build the binary
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -o locker ./cmd/locker

# Stage 2: Runtime
FROM registry.access.redhat.com/ubi9/ubi-minimal@sha256:580752f96d36c4132bffd30f9c34865bf4bd87f6aa161c969d117f21732e50f7

RUN microdnf install -y curl-minimal && microdnf clean all

WORKDIR /app

COPY --from=builder /build/locker /app/locker

RUN mkdir -p /data/ledgers && chown 1001:1001 /data/ledgers

ENV LOCKER_DATA_PATH="/data/ledgers" \
    LOCKER_LISTEN_ADDR=":8081"

USER 1001:1001

ENTRYPOINT ["/app/locker"]
