# Multi-stage build for locker service
# Stage 1: Build
FROM golang:1.27.1-alpine@sha256:8a5910f31396cd4d89662f56c68b3ae31d374308270a1c3bd96672ee5ed43414 AS builder

WORKDIR /build

COPY go.mod go.sum ./
RUN go mod download

COPY cmd cmd/
COPY events events/
COPY internal internal/

# Build the binary
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -o locker ./cmd/locker

# Stage 2: Runtime
FROM registry.access.redhat.com/ubi9/ubi-minimal@sha256:5ed244b62bbf4095080144d9d35eb8fcd3d39a9801f94aadd63b9d10978a01ae

RUN microdnf install -y curl-minimal && microdnf clean all

WORKDIR /app

COPY --from=builder /build/locker /app/locker

RUN mkdir -p /data/ledgers && chown 1001:1001 /data/ledgers

ENV LOCKER_DATA_PATH="/data/ledgers" \
    LOCKER_LISTEN_ADDR=":8081"

USER 1001:1001

ENTRYPOINT ["/app/locker"]
