# SPDX-License-Identifier: Apache-2.0

FROM golang:1.26@sha256:32c0e6e5c4f6707717051091b4d0b077464a679eaab563e11474efc5328e2aa5 AS builder

WORKDIR /app
COPY go.mod go.sum ./
RUN go mod download
COPY . .

ARG GOFIPS140=
ARG VERSION=dev
ARG COMMIT=unknown
RUN GOFIPS140=${GOFIPS140} CGO_ENABLED=0 go build \
    -ldflags "-X github.com/complytime-labs/complytime-core/internal/version.Version=${VERSION} -X github.com/complytime-labs/complytime-core/internal/version.Commit=${COMMIT}" \
    -o /complytime-monitor ./cmd/monitor/

FROM gcr.io/distroless/static-debian12:nonroot@sha256:b7bb25d9f7c31d2bdd1982feb4dafcaf137703c7075dbe2febb41c24212b946f

USER 65532

COPY --from=builder /complytime-monitor /complytime-monitor

# trivy:ignore:DS-0026 -- distroless has no shell or curl for HEALTHCHECK
ENTRYPOINT ["/complytime-monitor"]
