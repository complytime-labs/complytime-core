# Multi-stage build for gateway service
# Stage 1: Build
FROM golang:1.27rc2-alpine@sha256:dcbb18cc5fa1082364dc6aa95224b6b55429d09cbb9631a053d8064c1c367300 AS builder

WORKDIR /build

# Copy go.mod and go.sum
COPY go.mod go.sum ./

# Download dependencies
RUN go mod download

# Copy source code
COPY cmd cmd/
COPY events events/
COPY internal internal/

# Build the binary
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -o gateway ./cmd/gateway

# Stage 2: Runtime
FROM registry.access.redhat.com/ubi9/ubi-minimal@sha256:062c52ff973065752b0965787649db2bcf551a6c727a00e95a3eb42cebadbdab

RUN microdnf install -y curl-minimal && microdnf clean all

WORKDIR /app

COPY --from=builder /build/gateway /app/gateway

ENV NATS_URL="nats://localhost:4222" \
    LOCKER_URL="http://localhost:8081" \
    GATEWAY_LISTEN_ADDR=":8080"

USER 1001:1001

ENTRYPOINT ["/app/gateway"]
