# Multi-stage build for gateway service
# Stage 1: Build
FROM golang:1.27.1-alpine@sha256:cf6fca6641884b8433441b2b0652976f975e1d0fdd26d177eaaf8596087f3125 AS builder

WORKDIR /build

# Copy go.mod and go.sum
COPY go.mod go.sum ./

# Download dependencies
RUN go mod download

# Copy source code
COPY cmd cmd/
COPY events events/
COPY internal internal/

# Build the binary
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -o gateway ./cmd/gateway

# Stage 2: Runtime
FROM registry.access.redhat.com/ubi9/ubi-minimal@sha256:d235f607e1d6d833f031db107dc42206e4dd4d5aa9142c43d3771fb7f9bea76a

RUN microdnf install -y curl-minimal && microdnf clean all

WORKDIR /app

COPY --from=builder /build/gateway /app/gateway

ENV NATS_URL="nats://localhost:4222" \
    LOCKER_URL="http://localhost:8081" \
    GATEWAY_LISTEN_ADDR=":8080"

USER 1001:1001

ENTRYPOINT ["/app/gateway"]
