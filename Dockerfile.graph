# Multi-stage build for graph service
# Stage 1: Build
FROM golang:1.26.6-alpine@sha256:3889b425f035be855a72fb4755265311293b6d414521f0a519d819df32222d83 AS builder

WORKDIR /build

COPY go.mod go.sum ./
RUN go mod download

COPY cmd cmd/
COPY events events/
COPY internal internal/

# Build the binary
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -o graph ./cmd/graph

# Stage 2: Runtime
FROM registry.access.redhat.com/ubi9/ubi-minimal@sha256:8eb2830d0936237fc13a1f2f7e45aecf90d69043380ad167fad0343632937f41

RUN microdnf install -y curl-minimal && microdnf clean all

WORKDIR /app

COPY --from=builder /build/graph /app/graph

ENV GRAPH_LISTEN_ADDR=":8082" \
    NATS_URL="nats://localhost:4222" \
    LOCKER_URL="http://localhost:8081" \
    MEMGRAPH_URL="bolt://localhost:7687"

EXPOSE 8082

USER 1001:1001

ENTRYPOINT ["/app/graph"]
