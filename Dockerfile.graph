# Multi-stage build for graph service
# Stage 1: Build
FROM golang:1.27.3-alpine@sha256:fa3d596898d9f126af7c01d14ee7597bab3f39cccf392ef36b69fe77cd681f18 AS builder

WORKDIR /build

COPY go.mod go.sum ./
RUN go mod download

COPY cmd cmd/
COPY events events/
COPY internal internal/

# Build the binary
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -o graph ./cmd/graph

# Stage 2: Runtime
FROM registry.access.redhat.com/ubi9/ubi-minimal@sha256:4b79c93106c14ad1c234907f83441ff0e4f8d24e78426a36e159098e9f7e6fa5

RUN microdnf install -y curl-minimal && microdnf clean all

WORKDIR /app

COPY --from=builder /build/graph /app/graph

ENV GRAPH_LISTEN_ADDR=":8082" \
    NATS_URL="nats://localhost:4222" \
    LOCKER_URL="http://localhost:8081" \
    MEMGRAPH_URL="bolt://localhost:7687"

EXPOSE 8082

USER 1001:1001

ENTRYPOINT ["/app/graph"]
