# Multi-stage build for graph service
# Stage 1: Build
FROM golang:1.27.1-alpine@sha256:4cb7ac979db5fcc41cae44b2227ba5ab8a51e8807f40d9ba4dee20a0ad960b5b AS builder

WORKDIR /build

COPY go.mod go.sum ./
RUN go mod download

COPY cmd cmd/
COPY events events/
COPY internal internal/

# Build the binary
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -o graph ./cmd/graph

# Stage 2: Runtime
FROM registry.access.redhat.com/ubi9/ubi-minimal@sha256:d235f607e1d6d833f031db107dc42206e4dd4d5aa9142c43d3771fb7f9bea76a

RUN microdnf install -y curl-minimal && microdnf clean all

WORKDIR /app

COPY --from=builder /build/graph /app/graph

ENV GRAPH_LISTEN_ADDR=":8082" \
    NATS_URL="nats://localhost:4222" \
    LOCKER_URL="http://localhost:8081" \
    MEMGRAPH_URL="bolt://localhost:7687"

EXPOSE 8082

USER 1001:1001

ENTRYPOINT ["/app/graph"]
