# Multi-stage build for graph service
# Stage 1: Build
FROM golang:1.27.4-alpine@sha256:70bd7ddea8b6cbe5d6943cde279d6b67feb10cc924fb9100d1d8757c1575b280 AS builder

WORKDIR /build

COPY go.mod go.sum ./
RUN go mod download

COPY cmd cmd/
COPY events events/
COPY internal internal/

# Build the binary
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -o graph ./cmd/graph

# Stage 2: Runtime
FROM registry.access.redhat.com/ubi9/ubi-minimal@sha256:baafce2d34783a28b4a472779f304e97e00f9d35c99553bc53b068b14344d9a9

RUN microdnf install -y curl-minimal && microdnf clean all

WORKDIR /app

COPY --from=builder /build/graph /app/graph

ENV GRAPH_LISTEN_ADDR=":8082" \
    NATS_URL="nats://localhost:4222" \
    LOCKER_URL="http://localhost:8081" \
    MEMGRAPH_URL="bolt://localhost:7687"

EXPOSE 8082

USER 1001:1001

ENTRYPOINT ["/app/graph"]
