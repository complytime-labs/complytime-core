entity Publisher = {
  admin: Bool,
  service: Bool,
};

entity Subject = {
  publisher_trusted: Bool,
};

action "publish:artifact" appliesTo {
  principal: [Publisher],
  resource: [Subject],
};

action "admin:register-subject" appliesTo {
  principal: [Publisher],
  resource: [Subject],
};

action "admin:modify-trust" appliesTo {
  principal: [Publisher],
  resource: [Subject],
};

action "read:evidence" appliesTo {
  principal: [Publisher],
  resource: [Subject],
};

action "seal:evidence" appliesTo {
  principal: [Publisher],
  resource: [Subject],
};

action "verify:evidence" appliesTo {
  principal: [Publisher],
  resource: [Subject],
};

action "manage:ledger" appliesTo {
  principal: [Publisher],
  resource: [Subject],
};

action "query:evidence" appliesTo {
  principal: [Publisher],
  resource: [Subject],
};
