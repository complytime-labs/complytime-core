{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$defs": {
        "#Actor": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "contact": {
                    "$ref": "#/$defs/%23Contact"
                }
            },
            "$ref": "#/$defs/%23Entity"
        },
        "#ArtifactMapping": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "reference-id": {
                    "type": "string"
                },
                "remarks": {
                    "type": "string"
                }
            },
            "required": [
                "reference-id"
            ]
        },
        "#ArtifactType": {
            "enum": [
                "CapabilityCatalog",
                "ControlCatalog",
                "GuidanceCatalog",
                "ThreatCatalog",
                "RiskCatalog",
                "Policy",
                "MappingDocument",
                "Lexicon",
                "EvaluationLog",
                "EnforcementLog",
                "VectorCatalog",
                "PrincipleCatalog",
                "AuditLog"
            ]
        },
        "#Contact": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "affiliation": {
                    "type": "string"
                },
                "email": {
                    "$ref": "#/$defs/%23Email"
                },
                "name": {
                    "type": "string"
                },
                "social": {
                    "type": "string"
                }
            },
            "required": [
                "name"
            ]
        },
        "#Datetime": {
            "type": "string",
            "format": "date-time"
        },
        "#Email": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Za-z]{2,}$"
        },
        "#Entity": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "description": {
                    "type": "string"
                },
                "id": {
                    "type": "string"
                },
                "name": {
                    "type": "string"
                },
                "type": {
                    "$ref": "#/$defs/%23EntityType"
                },
                "uri": {
                    "type": "string",
                    "pattern": "^https?://[^\\s]+$"
                },
                "version": {
                    "type": "string"
                }
            },
            "required": [
                "id",
                "name",
                "type"
            ]
        },
        "#EntityType": {
            "enum": [
                "Human",
                "Software",
                "Software Assisted"
            ]
        },
        "#Group": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "description": {
                    "type": "string"
                },
                "id": {
                    "type": "string"
                },
                "title": {
                    "type": "string"
                }
            },
            "required": [
                "description",
                "id",
                "title"
            ]
        },
        "#LexiconReference": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "citation": {
                    "type": "string"
                },
                "url": {
                    "type": "string",
                    "pattern": "^(https?|file)://[^\\s]+$"
                }
            },
            "required": [
                "citation"
            ]
        },
        "#LexiconTerm": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "definition": {
                    "type": "string"
                },
                "id": {
                    "type": "string"
                },
                "references": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/%23LexiconReference"
                    },
                    "prefixItems": [
                        {
                            "$ref": "#/$defs/%23LexiconReference"
                        }
                    ],
                    "minItems": 1
                },
                "synonyms": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "prefixItems": [
                        {
                            "type": "string"
                        }
                    ],
                    "minItems": 1
                },
                "title": {
                    "type": "string"
                }
            },
            "required": [
                "definition",
                "id",
                "title"
            ]
        },
        "#MappingReference": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "description": {
                    "type": "string"
                },
                "id": {
                    "type": "string"
                },
                "title": {
                    "type": "string"
                },
                "url": {
                    "type": "string",
                    "pattern": "^(https?|file)://[^\\s]+$"
                },
                "version": {
                    "type": "string"
                }
            },
            "required": [
                "id",
                "title",
                "version"
            ]
        },
        "#Metadata": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "applicability-groups": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/%23Group"
                    },
                    "prefixItems": [
                        {
                            "$ref": "#/$defs/%23Group"
                        }
                    ],
                    "minItems": 1
                },
                "author": {
                    "$ref": "#/$defs/%23Actor"
                },
                "date": {
                    "$ref": "#/$defs/%23Datetime"
                },
                "description": {
                    "type": "string"
                },
                "draft": {
                    "type": "boolean"
                },
                "gemara-version": {
                    "type": "string"
                },
                "id": {
                    "type": "string"
                },
                "lexicon": {
                    "$ref": "#/$defs/%23ArtifactMapping"
                },
                "mapping-references": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/%23MappingReference"
                    },
                    "prefixItems": [
                        {
                            "$ref": "#/$defs/%23MappingReference"
                        }
                    ],
                    "minItems": 1
                },
                "type": {
                    "$ref": "#/$defs/%23ArtifactType"
                },
                "version": {
                    "type": "string"
                }
            },
            "required": [
                "author",
                "description",
                "gemara-version",
                "id",
                "type"
            ]
        }
    },
    "type": "object",
    "additionalProperties": false,
    "properties": {
        "metadata": {
            "type": "object",
            "properties": {
                "type": {
                    "const": "Lexicon"
                }
            },
            "$ref": "#/$defs/%23Metadata"
        },
        "terms": {
            "type": "array",
            "items": {
                "$ref": "#/$defs/%23LexiconTerm"
            },
            "prefixItems": [
                {
                    "$ref": "#/$defs/%23LexiconTerm"
                }
            ],
            "minItems": 1
        },
        "title": {
            "type": "string"
        }
    },
    "required": [
        "metadata",
        "terms",
        "title"
    ]
}
