{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$defs": {
        "#Actor": {
            "type": "object",
            "properties": {
                "contact": {
                    "$ref": "#/$defs/%23Contact"
                }
            },
            "$ref": "#/$defs/%23Entity",
            "unevaluatedProperties": false
        },
        "#ArtifactMapping": {
            "type": "object",
            "properties": {
                "reference-id": {
                    "type": "string"
                },
                "remarks": {
                    "type": "string"
                }
            },
            "required": [
                "reference-id"
            ]
        },
        "#ArtifactType": {
            "enum": [
                "CapabilityCatalog",
                "ControlCatalog",
                "GuidanceCatalog",
                "ThreatCatalog",
                "RiskCatalog",
                "Policy",
                "MappingDocument",
                "Lexicon",
                "EvaluationLog",
                "EnforcementLog",
                "VectorCatalog",
                "PrincipleCatalog",
                "AuditLog"
            ]
        },
        "#Catalog": {
            "type": "object",
            "properties": {
                "extends": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/%23ArtifactMapping"
                    }
                },
                "groups": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/%23Group"
                    },
                    "prefixItems": [
                        {
                            "$ref": "#/$defs/%23Group"
                        }
                    ],
                    "minItems": 1
                },
                "imports": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/%23MultiEntryMapping"
                    },
                    "prefixItems": [
                        {
                            "$ref": "#/$defs/%23MultiEntryMapping"
                        }
                    ],
                    "minItems": 1
                },
                "metadata": {
                    "type": "object",
                    "$ref": "#/$defs/%23Metadata",
                    "unevaluatedProperties": false
                },
                "title": {
                    "type": "string"
                }
            },
            "required": [
                "metadata",
                "title"
            ]
        },
        "#Contact": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "affiliation": {
                    "type": "string"
                },
                "email": {
                    "$ref": "#/$defs/%23Email"
                },
                "name": {
                    "type": "string"
                },
                "social": {
                    "type": "string"
                }
            },
            "required": [
                "name"
            ]
        },
        "#Datetime": {
            "type": "string",
            "format": "date-time"
        },
        "#Email": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Za-z]{2,}$"
        },
        "#Entity": {
            "type": "object",
            "properties": {
                "description": {
                    "type": "string"
                },
                "id": {
                    "type": "string"
                },
                "name": {
                    "type": "string"
                },
                "type": {
                    "$ref": "#/$defs/%23EntityType"
                },
                "uri": {
                    "type": "string",
                    "pattern": "^https?://[^\\s]+$"
                },
                "version": {
                    "type": "string"
                }
            },
            "required": [
                "id",
                "name",
                "type"
            ]
        },
        "#EntityType": {
            "enum": [
                "Human",
                "Software",
                "Software Assisted"
            ]
        },
        "#EntryMapping": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "entry-id": {
                    "type": "string"
                },
                "reference-id": {
                    "type": "string"
                },
                "remarks": {
                    "type": "string"
                }
            },
            "required": [
                "entry-id",
                "reference-id"
            ]
        },
        "#Exemption": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "description": {
                    "type": "string"
                },
                "reason": {
                    "type": "string"
                },
                "redirect": {
                    "$ref": "#/$defs/%23MultiEntryMapping"
                }
            },
            "required": [
                "description",
                "reason"
            ]
        },
        "#Group": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "description": {
                    "type": "string"
                },
                "id": {
                    "type": "string"
                },
                "title": {
                    "type": "string"
                }
            },
            "required": [
                "description",
                "id",
                "title"
            ]
        },
        "#GuidanceType": {
            "enum": [
                "Standard",
                "Regulation",
                "Best Practice",
                "Framework"
            ]
        },
        "#Guideline": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "applicability": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "prefixItems": [
                        {
                            "type": "string"
                        }
                    ],
                    "minItems": 1
                },
                "extends": {
                    "$ref": "#/$defs/%23EntryMapping"
                },
                "group": {
                    "type": "string"
                },
                "id": {
                    "type": "string"
                },
                "objective": {
                    "type": "string"
                },
                "principles": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/%23MultiEntryMapping"
                    },
                    "prefixItems": [
                        {
                            "$ref": "#/$defs/%23MultiEntryMapping"
                        }
                    ],
                    "minItems": 1
                },
                "rationale": {
                    "$ref": "#/$defs/%23Rationale"
                },
                "recommendations": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "prefixItems": [
                        {
                            "type": "string"
                        }
                    ],
                    "minItems": 1
                },
                "replaced-by": {
                    "$ref": "#/$defs/%23EntryMapping"
                },
                "see-also": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "prefixItems": [
                        {
                            "type": "string"
                        }
                    ],
                    "minItems": 1
                },
                "state": {
                    "$ref": "#/$defs/%23Lifecycle"
                },
                "statements": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/%23Statement"
                    },
                    "prefixItems": [
                        {
                            "$ref": "#/$defs/%23Statement"
                        }
                    ],
                    "minItems": 1
                },
                "title": {
                    "type": "string"
                },
                "vectors": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/%23MultiEntryMapping"
                    },
                    "prefixItems": [
                        {
                            "$ref": "#/$defs/%23MultiEntryMapping"
                        }
                    ],
                    "minItems": 1
                }
            },
            "required": [
                "group",
                "id",
                "objective",
                "title"
            ]
        },
        "#Lifecycle": {
            "enum": [
                "Active",
                "Draft",
                "Deprecated",
                "Retired"
            ]
        },
        "#MappingReference": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "description": {
                    "type": "string"
                },
                "id": {
                    "type": "string"
                },
                "title": {
                    "type": "string"
                },
                "url": {
                    "type": "string",
                    "pattern": "^(https?|file)://[^\\s]+$"
                },
                "version": {
                    "type": "string"
                }
            },
            "required": [
                "id",
                "title",
                "version"
            ]
        },
        "#Metadata": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "applicability-groups": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/%23Group"
                    },
                    "prefixItems": [
                        {
                            "$ref": "#/$defs/%23Group"
                        }
                    ],
                    "minItems": 1
                },
                "author": {
                    "$ref": "#/$defs/%23Actor"
                },
                "date": {
                    "$ref": "#/$defs/%23Datetime"
                },
                "description": {
                    "type": "string"
                },
                "draft": {
                    "type": "boolean"
                },
                "gemara-version": {
                    "type": "string"
                },
                "id": {
                    "type": "string"
                },
                "lexicon": {
                    "$ref": "#/$defs/%23ArtifactMapping"
                },
                "mapping-references": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/%23MappingReference"
                    },
                    "prefixItems": [
                        {
                            "$ref": "#/$defs/%23MappingReference"
                        }
                    ],
                    "minItems": 1
                },
                "type": {
                    "$ref": "#/$defs/%23ArtifactType"
                },
                "version": {
                    "type": "string"
                }
            },
            "required": [
                "author",
                "description",
                "gemara-version",
                "id",
                "type"
            ]
        },
        "#MultiEntryMapping": {
            "type": "object",
            "properties": {
                "entries": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/%23ArtifactMapping"
                    },
                    "prefixItems": [
                        {
                            "$ref": "#/$defs/%23ArtifactMapping"
                        }
                    ],
                    "minItems": 1
                }
            },
            "$ref": "#/$defs/%23ArtifactMapping",
            "required": [
                "entries"
            ],
            "unevaluatedProperties": false
        },
        "#Rationale": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "goals": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "prefixItems": [
                        {
                            "type": "string"
                        }
                    ],
                    "minItems": 1
                },
                "importance": {
                    "type": "string"
                }
            },
            "required": [
                "goals",
                "importance"
            ]
        },
        "#Statement": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "id": {
                    "type": "string"
                },
                "recommendations": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "prefixItems": [
                        {
                            "type": "string"
                        }
                    ],
                    "minItems": 1
                },
                "text": {
                    "type": "string"
                },
                "title": {
                    "type": "string"
                }
            },
            "required": [
                "id",
                "text"
            ]
        }
    },
    "type": "object",
    "properties": {
        "exemptions": {
            "type": "array",
            "items": {
                "$ref": "#/$defs/%23Exemption"
            },
            "prefixItems": [
                {
                    "$ref": "#/$defs/%23Exemption"
                }
            ],
            "minItems": 1
        },
        "front-matter": {
            "type": "string"
        },
        "guidelines": {
            "type": "array",
            "items": {
                "$ref": "#/$defs/%23Guideline"
            },
            "prefixItems": [
                {
                    "$ref": "#/$defs/%23Guideline"
                }
            ],
            "minItems": 1
        },
        "metadata": {
            "type": "object",
            "properties": {
                "type": {
                    "const": "GuidanceCatalog"
                }
            }
        },
        "type": {
            "$ref": "#/$defs/%23GuidanceType"
        }
    },
    "$ref": "#/$defs/%23Catalog",
    "required": [
        "type"
    ],
    "unevaluatedProperties": false
}
